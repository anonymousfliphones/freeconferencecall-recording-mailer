# FreeConferenceCall.com login
FCC_EMAIL=you@example.com
FCC_PASSWORD=your-fcc-password

# Optional: how many conferences to request per API page (max observed: 100).
# FCC_PAGE_SIZE=100

# SMTP / email delivery
# Gmail: host=smtp.gmail.com port=587, username = your Gmail address,
# password = a 16-character Gmail "App Password" (NOT your normal login
# password). Requires 2-Step Verification enabled on the Google account.
# Generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=recipient@example.com

# Optional: audio compression tuning
# MP3_BITRATE=24k
# MP3_SAMPLE_RATE=16000

# Optional: local paths / behavior
# WORK_DIR=./tmp
# TRACKING_FILE=./downloaded_ids.json
# MAX_RECORDINGS_PER_RUN=5
